docs/prd.md

# Generated indexer output — kept out of git during M0 until the schema and
# merge driver stabilize (PRD §3, §6; revisit in the M3 plan).
# Authored decision records are the exception: nothing can regenerate
# rationale, and file-per-decision is merge-safe by construction.
.reposkein/*
!.reposkein/decisions/

# Local-only working docs (plans, skill scratch) — never commit.
docs/superpowers/

# Cached indexer binary (postinstall fetch, M4-D1) — never commit.
mcp/bin/

# Local agent/session artifacts — never commit.
.claude/
.omo/

# Python bytecode (embed-server runs locally during dev).
**/__pycache__/
*.pyc

# Per-machine MCP config written by setup: absolute paths + a local backend
# password. Regenerated by `reposkein-mcp init`; only .reposkein/ is shared.
.mcp.json
opencode.json
