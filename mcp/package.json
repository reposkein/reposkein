{
  "name": "@reposkein/mcp",
  "version": "0.8.0",
  "description": "RepoSkein gives your AI coding agent a map of your codebase — so it navigates structure instead of grepping and guessing.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-agents",
    "code-graph",
    "graphrag",
    "rag",
    "tree-sitter",
    "static-analysis",
    "code-intelligence",
    "code-navigation",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "developer-tools",
    "reposkein"
  ],
  "homepage": "https://github.com/reposkein/reposkein#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reposkein/reposkein.git",
    "directory": "mcp"
  },
  "bugs": {
    "url": "https://github.com/reposkein/reposkein/issues"
  },
  "author": "RepoSkein",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "reposkein-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "bin",
    "binary-digests.json"
  ],
  "scripts": {
    "build": "tsc && node scripts/chmod-bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "prepare": "npm run build && node scripts/bundle-skill.mjs && node scripts/bundle-viz.mjs",
    "postinstall": "node scripts/postinstall.mjs",
    "bench": "tsx bench/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "lulu-ads": "^0.9.0",
    "neo4j-driver": "^6.1.0",
    "undici": "^8.10.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.9"
  }
}
