  "private": true,
  "description": "RepoSkein 3D constellation graph viewer (read-only SPA over committed .reposkein JSONL).",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
