    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^4.3.2",
    "esbuild": "^0.28.2",
    "eslint": "^9.12.0",
    "jsdom": "^30.0.1",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.8.1",
