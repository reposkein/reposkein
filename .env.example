# Environment variables RepoSkein reads.
#
# Nothing loads this file automatically — the MCP server reads the process
# environment. Copy the lines you need into your shell profile, your agent's
# MCP config `env` block, or a `.env` you source yourself (`.env` is
# gitignored; this example file is not).

# --- Sponsorship (OFF by default — see docs/SPONSORSHIP.md) -----------------
# The opt-in switch. Unset or "off" means no sponsorship code ever runs and no
# network call is ever made. "on" opts this machine in; `[ads] enabled = true`
# in .reposkein/config.toml opts a repo in. "off" always wins.
REPOSKEIN_ADS=

# Ad-network credentials, from https://getlulu.dev/publishers. Absent either
# one, the integration is inert: opting in without credentials changes nothing.
# Env only — never commit these, never put them in config.toml.
LULU_ADS_PUBLISHER_ID=
LULU_ADS_API_KEY=
# Override the ad-network base URL (testing / self-hosted mock only). The
# click-URL host allowlist is derived from whatever this resolves to.
LULU_ADS_BASE_URL=

# --- Optional stores and providers ------------------------------------------
# Neo4j backend (docs/NEO4J.md). Absent NEO4J_PASSWORD, the committed
# JSONL store is used and no database is needed.
NEO4J_URI=
NEO4J_USER=
NEO4J_PASSWORD=

# Hybrid semantic_find embeddings (docs/EMBEDDINGS.md).
VOYAGE_API_KEY=
REPOSKEIN_EMBED_URL=

# --- Server behaviour -------------------------------------------------------
# Repo root when the server should not discover one (docs/INSTALL.md).
REPOSKEIN_REPO_PATH=
# Writer identity recorded on summaries and decisions.
REPOSKEIN_AGENT=
